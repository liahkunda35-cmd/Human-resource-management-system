# Application tier only — never expose these via VITE_*
PORT=4000
NODE_ENV=development

# PostgreSQL (Data tier) — backend only
DATABASE_URL=postgresql://aurelia:aurelia@localhost:5432/aurelia_hrms

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Initial Super Admin (seed only — stored as a hash in the database)
SEED_SUPER_ADMIN_EMAIL=superadmin@zamtech.co.zm
SEED_SUPER_ADMIN_PASSWORD=

# Development Admin / HR sign-in. Ignored when NODE_ENV=production.
# These values are not written to the database. Set DEV_ADMIN_ENABLED=false to turn this off.
DEV_ADMIN_ENABLED=true
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=hr.admin@zamtech.co.zm
# Quote the password when it contains # so dotenv does not treat the rest as a comment.
DEV_ADMIN_PASSWORD=

# Development Employee sign-in. Ignored when NODE_ENV=production.
DEV_EMPLOYEE_ENABLED=true
DEV_EMPLOYEE_USERNAME=employee
DEV_EMPLOYEE_EMAIL=employee@zamtech.co.zm
DEV_EMPLOYEE_PASSWORD=

DEV_MALE_EMPLOYEE_ENABLED=true
DEV_MALE_EMPLOYEE_USERNAME=male
DEV_MALE_EMPLOYEE_EMAIL=male@zamtech.co.zm
DEV_MALE_EMPLOYEE_PASSWORD=

DEV_MALE_EMPLOYEE_ENABLED=true
DEV_MALE_EMPLOYEE_USERNAME=male
DEV_MALE_EMPLOYEE_EMAIL=male@zamtech.co.zm
DEV_MALE_EMPLOYEE_PASSWORD=
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin

# Nexus Notification API (server-side only)
NEXUS_API_KEY=
NEXUS_BASE_URL=https://nexuszm.com/api/v1
NEXUS_APP_URL=http://localhost:5173

# CORS and links inside activation emails
FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# Gmail SMTP for employee activation emails. Server-side only.
# Use a Google App Password. Never commit the real value.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
