# Frontend (Presentation tier) — safe for Vite
# Leave empty to use Vite proxy → http://localhost:4000/api
VITE_API_URL=

# Optional Google OAuth (disabled for account-creation flow; kept for compatibility)
VITE_GOOGLE_CLIENT_ID=

